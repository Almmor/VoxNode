<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ 未配置：服务器设置 ============ -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_hint"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/setup_link_hint"
                app:boxBackgroundColor="@color/card"
                app:boxStrokeColor="@color/accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:textColor="@color/text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaste"
                    style="@style/Widget.VoxNode.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_paste" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Widget.VoxNode.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_connect" />
            </LinearLayout>

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ============ 已配置：遥控面板 ============ -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/accent"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connecting"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.VoxNode.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_settings" />
            </LinearLayout>

            <!-- 实时状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/VoxNode.StatCard">
                    <TextView style="@style/VoxNode.StatLabel" android:text="@string/stat_cpu" />
                    <TextView android:id="@+id/txtCpu" style="@style/VoxNode.StatValue" android:text="--" />
                    <ProgressBar
                        android:id="@+id/barCpu"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bar_track" />
                </LinearLayout>

                <LinearLayout style="@style/VoxNode.StatCard" android:layout_marginStart="9dp">
                    <TextView style="@style/VoxNode.StatLabel" android:text="@string/stat_mem" />
                    <TextView android:id="@+id/txtMem" style="@style/VoxNode.StatValue" android:text="--" />
                    <ProgressBar
                        android:id="@+id/barMem"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bar_track" />
                </LinearLayout>

                <LinearLayout style="@style/VoxNode.StatCard" android:layout_marginStart="9dp">
                    <TextView style="@style/VoxNode.StatLabel" android:text="@string/stat_disk" />
                    <TextView android:id="@+id/txtDisk" style="@style/VoxNode.StatValue" android:text="--" />
                    <ProgressBar
                        android:id="@+id/barDisk"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bar_track" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/VoxNode.Section" android:text="@string/sec_power" />
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLock"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_lock" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSleep"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_sleep" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_cancel" />
            </LinearLayout>
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnHibernate"
                    style="@style/Widget.VoxNode.Button.Danger"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_hibernate" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSignout"
                    style="@style/Widget.VoxNode.Button.Danger"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_signout" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRestart"
                    style="@style/Widget.VoxNode.Button.Danger"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_restart" />
            </LinearLayout>
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnShutdown"
                    style="@style/Widget.VoxNode.Button.Danger"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_shutdown" />
            </LinearLayout>

            <TextView style="@style/VoxNode.Section" android:text="@string/sec_common" />
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnScreenshot"
                    style="@style/Widget.VoxNode.Button.Primary"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_screenshot" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnStatus"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_status" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnScreen"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_view_screen" />
            </LinearLayout>

            <TextView style="@style/VoxNode.Section" android:text="@string/sec_media" />
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnVolDown"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_vol_down" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnMute"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_mute" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnVolUp"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_vol_up" />
            </LinearLayout>
            <LinearLayout style="@style/VoxNode.Row">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrev"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/act_prev" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPlayPause"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_play_pause" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNext"
                    style="@style/Widget.VoxNode.Button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/act_next" />
            </LinearLayout>

            <TextView style="@style/VoxNode.Section" android:text="@string/sec_apps" />
            <TextView android:id="@+id/txtAppsEmpty" style="@style/VoxNode.Empty"
                android:text="@string/empty_apps" />
            <LinearLayout android:id="@+id/boxApps" style="@style/VoxNode.Row" />

            <TextView style="@style/VoxNode.Section" android:text="@string/sec_wol" />
            <TextView android:id="@+id/txtWolEmpty" style="@style/VoxNode.Empty"
                android:text="@string/empty_wol" />
            <LinearLayout android:id="@+id/boxWol" style="@style/VoxNode.Row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/footer"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
